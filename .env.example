# Copy to .env.local for `vercel dev`, and set the same vars in the Vercel
# project settings for deployed environments. Never commit the real values.

# Claude — /api/curate
ANTHROPIC_API_KEY=

# Apple DeviceCheck — /api/entitlement/*
# Contents of the .p8 private key (real newlines, \n escapes, or base64 PEM)
APPLE_DEVICECHECK_KEY=
APPLE_DEVICECHECK_KEY_ID=
APPLE_TEAM_ID=
# production (default) | development — see README, the two hosts have
# SEPARATE bit storage
APPLE_DEVICECHECK_ENV=production
