# Copy to .env.local for `vercel dev`, and set the same vars in the Vercel
# project settings for deployed environments. Never commit the real values.

# Claude — /api/curate
ANTHROPIC_API_KEY=

# Apple DeviceCheck — /api/entitlement/*
# Contents of the .p8 private key (real newlines, \n escapes, or base64 PEM)
APPLE_DEVICECHECK_KEY=
APPLE_DEVICECHECK_KEY_ID=
APPLE_TEAM_ID=
# production (default) | development — see README, the two hosts have
# SEPARATE bit storage
APPLE_DEVICECHECK_ENV=production

# Premium tier — /api/premium/generate
# Which generation provider to use. `stub` returns the input image unchanged
# and needs no credentials; `fal` runs fal-ai/flux-pro/kontext for real.
# Default is stub so nothing spends by accident.
IMAGE_PROVIDER=stub
# Max simultaneous generations. Set to the fal account's concurrency limit —
# 10 on this account. (fal starts new accounts at 2 and scales to 40.)
IMAGE_PROVIDER_CONCURRENCY=10
# Per-call ceiling in ms.
IMAGE_PROVIDER_TIMEOUT_MS=90000
# Optional comma-separated allowlist for photo URLs. Suffix-matched, so
# `fal.media` covers v3.fal.media and v3b.fal.media. Recommended once the app
# is using /api/premium/upload-targets, so only fal-hosted photos are accepted.
PREMIUM_ALLOWED_IMAGE_HOSTS=fal.media

# Stub-only test knobs — fake latency, and a 0..1 forced failure rate for
# exercising the retry/fallback path. Leave unset in production.
IMAGE_PROVIDER_STUB_DELAY_MS=
IMAGE_PROVIDER_STUB_FAIL_RATE=

# fal.ai — image generation + CDN upload targets
FAL_KEY=
# Overridable so a fal-side change is a config edit, not a redeploy.
FAL_MODEL=fal-ai/flux-pro/kontext
FAL_QUEUE_HOST=https://queue.fal.run
FAL_REST_HOST=https://rest.fal.ai
FAL_STORAGE_TYPE=fal-cdn-v3
# How long uploaded photos and generated images live on fal's CDN. 0 = forever.
FAL_OBJECT_EXPIRY_SECONDS=86400
