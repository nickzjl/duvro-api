# Copy to .env.local for `vercel dev`, and set the same vars in the Vercel
# project settings for deployed environments. Never commit the real values.

# Claude — /api/curate
ANTHROPIC_API_KEY=

# Apple DeviceCheck — /api/entitlement/*
# Contents of the .p8 private key (real newlines, \n escapes, or base64 PEM)
APPLE_DEVICECHECK_KEY=
APPLE_DEVICECHECK_KEY_ID=
APPLE_TEAM_ID=
# production (default) | development — see README, the two hosts have
# SEPARATE bit storage
APPLE_DEVICECHECK_ENV=production

# Premium tier — /api/premium/generate
# Which generation provider to use. `stub` returns the input image unchanged
# and needs no credentials — the default, since no model has been chosen.
IMAGE_PROVIDER=stub
# Max simultaneous generations. SET THIS TO THE PROVIDER'S REAL CAP once one
# is chosen; see README's "If the provider's concurrency cap is very low".
IMAGE_PROVIDER_CONCURRENCY=3
# Per-call ceiling in ms.
IMAGE_PROVIDER_TIMEOUT_MS=90000
# Optional comma-separated allowlist for photo URLs, e.g. blob.example.com
PREMIUM_ALLOWED_IMAGE_HOSTS=

# Stub-only test knobs — fake latency, and a 0..1 forced failure rate for
# exercising the retry/fallback path. Leave unset in production.
IMAGE_PROVIDER_STUB_DELAY_MS=
IMAGE_PROVIDER_STUB_FAIL_RATE=
